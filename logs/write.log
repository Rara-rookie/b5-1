"""Mini Redis 자료구조/명령어/CLI 통합 검증 테스트 스위트."""

import importlib
import os
import subprocess
import sys
import time
import unittest


class FakeClock:
    """시간 의존 로직을 결정적으로 검증하기 위한 가짜 시계이다."""

    def __init__(self, start: float = 1000.0) -> None:
        """고정 시작 시각으로 가짜 시계를 초기화한다."""
        self.current = start

    def now(self) -> float:
        """현재 가짜 시각을 반환한다."""
        return self.current

    def advance(self, seconds: float) -> None:
        """테스트가 만료 시점을 명시적으로 제어할 수 있게 시각을 전진시킨다."""
        self.current += seconds


def _import_attr(module_name: str, attr_name: str):
    """프로젝트 구현 차이를 흡수하기 위해 모듈에서 속성을 동적으로 가져온다."""
    module = importlib.import_module(module_name)
    return getattr(module, attr_name)


def _import_optional_attr(module_names: list[str], attr_name: str):
    """여러 후보 모듈 중 실제로 구현된 위치에서 속성을 찾는다."""
    last_error = None
    for module_name in module_names:
        try:
            module = importlib.import_module(module_name)
            if hasattr(module, attr_name):
                return getattr(module, attr_name)
        except Exception as error:
            last_error = error
    if last_error is not None:
        raise last_error
    raise AttributeError(attr_name)


def _make_server(now_fn=None):
    """Mini Redis 서버 인스턴스를 여러 생성자 형태에 맞춰 생성한다."""
    candidates = [
        ("mini_redis.core", "MiniRedis"),
        ("mini_redis.redis", "MiniRedis"),
        ("mini_redis.server", "MiniRedis"),
        ("mini_redis.core", "MiniRedisServer"),
        ("mini_redis.redis", "MiniRedisServer"),
        ("mini_redis.server", "MiniRedisServer"),
    ]

    server_cls = _import_optional_attr(
        [module_name for module_name, _ in candidates],
        "MiniRedis",
    )
    if server_cls.__name__ != "MiniRedis":
        server_cls = _import_optional_attr(
            [module_name for module_name, _ in candidates],
            "MiniRedisServer",
        )

    if now_fn is not None:
        try:
            return server_cls(now_fn=now_fn)
        except TypeError:
            instance = server_cls()
            if hasattr(instance, "now_fn"):
                instance.now_fn = now_fn
            elif hasattr(instance, "_now_fn"):
                instance._now_fn = now_fn
            return instance

    return server_cls()


def _execute(server, command_line: str) -> str:
    """구현체의 명령 실행 인터페이스 차이를 흡수해 문자열 결과를 얻는다."""
    method_names = [
        "execute",
        "execute_command",
        "run_command",
        "handle_command",
        "process_command",
    ]

    last_error = None
    for method_name in method_names:
        if hasattr(server, method_name):
            method = getattr(server, method_name)
            try:
                result = method(command_line)
            except TypeError:
                parts = command_line.split()
                result = method(parts)
            if isinstance(result, str):
                return result
            return str(result)

    try:
        cli_module = importlib.import_module("mini_redis.cli")
        if hasattr(cli_module, "execute_command"):
            result = cli_module.execute_command(server, command_line)
            if isinstance(result, str):
                return result
            return str(result)
    except Exception as error:
        last_error = error

    if last_error is not None:
        raise last_error
    raise AttributeError("No executable command interface found.")


def _normalize_lines(text: str) -> str:
    """플랫폼 개행 차이로 인한 오탐을 줄이기 위해 문자열을 정규화한다."""
    return text.replace("\r\n", "\n").strip()


class TestDoublyLinkedList(unittest.TestCase):
    """이중 연결 리스트의 핵심 포인터 연산을 검증한다."""

    def setUp(self) -> None:
        """각 테스트 전에 새 리스트를 준비한다."""
        self.Node = _import_attr("mini_redis.linked_list", "Node")
        self.DoublyLinkedList = _import_attr("mini_redis.linked_list", "DoublyLinkedList")

    def test_insert_front_and_back(self) -> None:
        """앞뒤 삽입이 head/tail과 이웃 포인터를 올바르게 만든다."""
        linked = self.DoublyLinkedList()

        n2 = linked.insert_front("b")
        n1 = linked.insert_front("a")
        n3 = linked.insert_back("c")

        self.assertEqual(linked.head.data, "a")
        self.assertEqual(linked.tail.data, "c")
        self.assertIs(linked.head, n1)
        self.assertIs(linked.tail, n3)
        self.assertIsNone(n1.prev)
        self.assertIs(n1.next, n2)
        self.assertIs(n2.prev, n1)
        self.assertIs(n2.next, n3)
        self.assertIs(n3.prev, n2)
        self.assertIsNone(n3.next)

    def test_remove_front_and_back_on_empty_and_singleton(self) -> None:
        """빈 리스트와 단일 원소 리스트의 제거 경계를 검증한다."""
        linked = self.DoublyLinkedList()

        self.assertIsNone(linked.remove_front())
        self.assertIsNone(linked.remove_back())

        linked.insert_front("only")
        self.assertEqual(linked.remove_front(), "only")
        self.assertIsNone(linked.head)
        self.assertIsNone(linked.tail)

        linked.insert_back("only")
        self.assertEqual(linked.remove_back(), "only")
        self.assertIsNone(linked.head)
        self.assertIsNone(linked.tail)

    def test_remove_node_middle_head_tail(self) -> None:
        """임의 노드 제거가 탐색 없이 구조를 보존하는지 검증한다."""
        linked = self.DoublyLinkedList()
        n1 = linked.insert_back("a")
        n2 = linked.insert_back("b")
        n3 = linked.insert_back("c")

        linked.remove_node(n2)
        self.assertEqual(linked.head.data, "a")
        self.assertEqual(linked.tail.data, "c")
        self.assertIs(n1.next, n3)
        self.assertIs(n3.prev, n1)
        self.assertIsNone(n2.prev)
        self.assertIsNone(n2.next)

        linked.remove_node(n1)
        self.assertEqual(linked.head.data, "c")
        self.assertEqual(linked.tail.data, "c")
        self.assertIsNone(n3.prev)

        linked.remove_node(n3)
        self.assertIsNone(linked.head)
        self.assertIsNone(linked.tail)

    def test_move_to_front(self) -> None:
        """중간/끝 노드를 앞으로 옮길 때 순서가 올바르게 갱신된다."""
        linked = self.DoublyLinkedList()
        n1 = linked.insert_back("a")
        n2 = linked.insert_back("b")
        n3 = linked.insert_back("c")

        linked.move_to_front(n3)
        self.assertIs(linked.head, n3)
        self.assertIs(linked.tail, n2)
        self.assertIsNone(n3.prev)
        self.assertIs(n3.next, n1)
        self.assertIs(n1.prev, n3)
        self.assertIs(n1.next, n2)
        self.assertIs(n2.prev, n1)

        linked.move_to_front(n1)
        self.assertIs(linked.head, n1)
        self.assertEqual(linked.head.data, "a")
        self.assertEqual(linked.tail.data, "b")

        linked.move_to_front(n1)
        self.assertIs(linked.head, n1)
        self.assertEqual(linked.head.data, "a")


class TestHashMap(unittest.TestCase):
    """체이닝 해시맵의 충돌 처리와 리사이즈 규칙을 검증한다."""

    def setUp(self) -> None:
        """각 테스트 전에 해시맵 클래스를 불러온다."""
        self.HashMap = _import_attr("mini_redis.hashmap", "HashMap")

    def test_hash_index_in_range(self) -> None:
        """해시 함수는 항상 현재 버킷 범위 안의 인덱스를 반환해야 한다."""
        hashmap = self.HashMap()
        for key in ["a", "abc", "user:1", "한글", "long-key-value"]:
            index = hashmap._hash(key)
            self.assertGreaterEqual(index, 0)
            self.assertLess(index, hashmap._capacity)

    def test_put_get_remove_contains_keys_size(self) -> None:
        """기본 CRUD와 메타 정보 메서드가 일관되게 동작해야 한다."""
        hashmap = self.HashMap()

        hashmap.put("user:1", "A")
        hashmap.put("user:2", "B")
        hashmap.put("user:1", "AA")

        self.assertEqual(hashmap.get("user:1"), "AA")
        self.assertEqual(hashmap.get("user:2"), "B")
        self.assertTrue(hashmap.contains("user:1"))
        self.assertFalse(hashmap.contains("user:3"))
        self.assertEqual(hashmap.size(), 2)

        keys = hashmap.keys()
        self.assertEqual(len(keys), 2)
        self.assertIn("user:1", keys)
        self.assertIn("user:2", keys)

        self.assertTrue(hashmap.remove("user:2"))
        self.assertFalse(hashmap.remove("user:2"))
        self.assertIsNone(hashmap.get("user:2"))
        self.assertEqual(hashmap.size(), 1)

    def test_chaining_collision_resolution(self) -> None:
        """같은 버킷에 몰린 키들도 각각 독립적으로 조회/삭제되어야 한다."""
        class CollisionHashMap(self.HashMap):
            """충돌 상황을 강제로 만들기 위한 테스트 전용 해시맵이다."""

            def _hash(self, key: str) -> int:
                """모든 키를 같은 버킷으로 보내 체이닝 구현을 직접 검증한다."""
                return 0

        hashmap = CollisionHashMap()
        hashmap.put("k1", "v1")
        hashmap.put("k2", "v2")
        hashmap.put("k3", "v3")

        self.assertEqual(hashmap.get("k1"), "v1")
        self.assertEqual(hashmap.get("k2"), "v2")
        self.assertEqual(hashmap.get("k3"), "v3")
        self.assertTrue(hashmap.remove("k2"))
        self.assertEqual(hashmap.get("k1"), "v1")
        self.assertIsNone(hashmap.get("k2"))
        self.assertEqual(hashmap.get("k3"), "v3")
        self.assertEqual(hashmap.size(), 2)

    def test_resize_when_load_factor_exceeds_threshold(self) -> None:
        """8칸 테이블은 7번째 새 키에서 16칸으로 늘어나야 한다."""
        hashmap = self.HashMap(8)

        for index in range(6):
            hashmap.put("k" + str(index), "v" + str(index))
        self.assertEqual(hashmap._capacity, 8)

        hashmap.put("k6", "v6")
        self.assertEqual(hashmap._capacity, 16)

        for index in range(7):
            self.assertEqual(hashmap.get("k" + str(index)), "v" + str(index))


class TestMinHeap(unittest.TestCase):
    """최소 힙의 TTL 우선순위 동작을 검증한다."""

    def setUp(self) -> None:
        """각 테스트 전에 최소 힙 클래스를 불러온다."""
        self.MinHeap = _import_attr("mini_redis.heap", "MinHeap")

    def test_push_peek_size(self) -> None:
        """삽입 후 루트 최소값과 크기 정보가 일치해야 한다."""
        heap = self.MinHeap()
        self.assertEqual(heap.size(), 0)
        self.assertIsNone(heap.peek())

        heap.push((30.0, "c"))
        heap.push((10.0, "a"))
        heap.push((20.0, "b"))

        self.assertEqual(heap.size(), 3)
        self.assertEqual(heap.peek(), (10.0, "a"))

    def test_pop_in_sorted_expire_order(self) -> None:
        """pop은 가장 이른 만료 시각부터 반환해야 한다."""
        heap = self.MinHeap()
        items = [(30.0, "c"), (10.0, "a"), (20.0, "b"), (10.0, "aa")]
        for item in items:
            heap.push(item)

        popped = [heap.pop(), heap.pop(), heap.pop(), heap.pop(), heap.pop()]
        self.assertEqual(popped[0], (10.0, "a"))
        self.assertEqual(popped[1], (10.0, "aa"))
        self.assertEqual(popped[2], (20.0, "b"))
        self.assertEqual(popped[3], (30.0, "c"))
        self.assertIsNone(popped[4])
        self.assertEqual(heap.size(), 0)


class TestMiniRedisCommands(unittest.TestCase):
    """문자열 명령어, 메모리 관리, TTL, 에러 처리를 통합 검증한다."""

    def setUp(self) -> None:
        """각 테스트 전에 독립된 서버 인스턴스를 준비한다."""
        self.clock = FakeClock()
        self.server = _make_server(now_fn=self.clock.now)

    def cmd(self, line: str) -> str:
        """짧은 표기로 명령을 실행한다."""
        return _normalize_lines(_execute(self.server, line))

    def test_string_commands_and_empty_keys_output(self) -> None:
        """문자열 명령어 6종의 기본 규칙과 빈 키 목록 표현을 검증한다."""
        self.assertEqual(self.cmd("GET no-key"), "(nil)")
        self.assertEqual(self.cmd("EXISTS no-key"), "(integer) 0")
        self.assertEqual(self.cmd("DBSIZE"), "(integer) 0")

        keys_output = self.cmd("KEYS")
        self.assertIn("(empty array)", keys_output)

        self.assertEqual(self.cmd("SET user:1 Alice"), "OK")
        self.assertEqual(self.cmd("GET user:1"), '"Alice"')
        self.assertEqual(self.cmd("EXISTS user:1"), "(integer) 1")
        self.assertEqual(self.cmd("DBSIZE"), "(integer) 1")

        self.assertEqual(self.cmd("SET user:2 Bob"), "OK")
        keys_output = self.cmd("KEYS")
        self.assertIn('"user:1"', keys_output)
        self.assertIn('"user:2"', keys_output)

        self.assertEqual(self.cmd("DEL user:1"), "(integer) 1")
        self.assertEqual(self.cmd("DEL user:1"), "(integer) 0")
        self.assertEqual(self.cmd("GET user:1"), "(nil)")
        self.assertEqual(self.cmd("DBSIZE"), "(integer) 1")

    def test_memory_info_and_lru_eviction(self) -> None:
        """메모리 제한 초과 시 가장 오래 사용되지 않은 키부터 제거되어야 한다."""
        self.assertEqual(self.cmd("CONFIG SET maxmemory 30"), "OK")
        self.assertEqual(self.cmd("SET user:1 abcde"), "OK")
        self.assertEqual(self.cmd("SET user:2 abcde"), "OK")
        self.assertEqual(self.cmd("SET user:3 abcde"), "OK")

        self.assertEqual(self.cmd("GET user:1"), "(nil)")
        info = self.cmd("INFO memory")
        self.assertIn("used_memory:22", info)
        self.assertIn("maxmemory:30", info)
        self.assertIn("evicted_keys:1", info)
        self.assertEqual(self.cmd("GET user:2"), '"abcde"')
        self.assertEqual(self.cmd("GET user:3"), '"abcde"')

    def test_get_updates_lru_order_before_next_eviction(self) -> None:
        """성공한 GET만 최신 사용으로 승격되어 다음 제거 대상을 바꿔야 한다."""
        self.assertEqual(self.cmd("CONFIG SET maxmemory 24"), "OK")
        self.assertEqual(self.cmd("SET a 1234567"), "OK")
        self.assertEqual(self.cmd("SET b 1234567"), "OK")
        self.assertEqual(self.cmd("GET a"), '"1234567"')
        self.assertEqual(self.cmd("SET c 1234567"), "OK")

        self.assertEqual(self.cmd("GET a"), '"1234567"')
        self.assertEqual(self.cmd("GET b"), "(nil)")
        self.assertEqual(self.cmd("GET c"), '"1234567"')

    def test_single_entry_larger_than_maxmemory_returns_oom(self) -> None:
        """단일 엔트리 자체가 제한을 넘으면 저장하지 않고 OOM이어야 한다."""
        self.assertEqual(self.cmd("CONFIG SET maxmemory 5"), "OK")
        result = self.cmd("SET too_big 123456")
        self.assertEqual(result, "(error) OOM command not allowed when used memory > 'maxmemory'")
        self.assertEqual(self.cmd("GET too_big"), "(nil)")
        self.assertEqual(self.cmd("DBSIZE"), "(integer) 0")

    def test_ttl_lifecycle_and_edge_cases(self) -> None:
        """TTL 조회 규칙, 만료 삭제, 덮어쓰기 초기화, 즉시 만료를 검증한다."""
        self.assertEqual(self.cmd("TTL no-key"), "(integer) -2")

        self.assertEqual(self.cmd("SET session token"), "OK")
        self.assertEqual(self.cmd("TTL session"), "(integer) -1")
        self.assertEqual(self.cmd("EXPIRE session 10"), "(integer) 1")
        self.assertEqual(self.cmd("TTL session"), "(integer) 10")

        self.clock.advance(3)
        ttl_after_3 = self.cmd("TTL session")
        self.assertEqual(ttl_after_3, "(integer) 7")

        self.clock.advance(8)
        self.assertEqual(self.cmd("GET session"), "(nil)")
        self.assertEqual(self.cmd("TTL session"), "(integer) -2")

        self.assertEqual(self.cmd("SET user value1"), "OK")
        self.assertEqual(self.cmd("EXPIRE user 100"), "(integer) 1")
        self.assertEqual(self.cmd("SET user value2"), "OK")
        self.assertEqual(self.cmd("TTL user"), "(integer) -1")

        self.assertEqual(self.cmd("SET temp value"), "OK")
        self.assertEqual(self.cmd("EXPIRE temp 0"), "(integer) 1")
        self.assertEqual(self.cmd("GET temp"), "(nil)")
        self.assertEqual(self.cmd("TTL temp"), "(integer) -2")

        self.assertEqual(self.cmd("EXPIRE no-key 10"), "(integer) 0")

    def test_expired_get_does_not_refresh_lru(self) -> None:
        """만료로 사라진 GET은 사용 갱신이 아니므로 다른 키를 밀어내지 않아야 한다."""
        self.assertEqual(self.cmd("CONFIG SET maxmemory 12"), "OK")
        self.assertEqual(self.cmd("SET a 12345"), "OK")
        self.assertEqual(self.cmd("SET b 12345"), "OK")
        self.assertEqual(self.cmd("EXPIRE a 1"), "(integer) 1")

        self.clock.advance(2)
        self.assertEqual(self.cmd("GET a"), "(nil)")
        self.assertEqual(self.cmd("SET c 12345"), "OK")

        self.assertEqual(self.cmd("GET b"), '"12345"')
        self.assertEqual(self.cmd("GET c"), '"12345"')

    def test_del_removes_data_ttl_and_lru_together(self) -> None:
        """DEL 이후에는 데이터 조회, TTL 조회, 존재 여부가 모두 비어 있어야 한다."""
        self.assertEqual(self.cmd("SET key value"), "OK")
        self.assertEqual(self.cmd("EXPIRE key 10"), "(integer) 1")
        self.assertEqual(self.cmd("DEL key"), "(integer) 1")
        self.assertEqual(self.cmd("GET key"), "(nil)")
        self.assertEqual(self.cmd("TTL key"), "(integer) -2")
        self.assertEqual(self.cmd("EXISTS key"), "(integer) 0")

    def test_error_messages(self) -> None:
        """표준 에러 메시지 4종이 요구 형식과 일치해야 한다."""
        self.assertEqual(self.cmd("NOPE"), "(error) ERR unknown command 'NOPE'")
        self.assertEqual(self.cmd("GET"), "(error) ERR wrong number of arguments for 'GET' command")
        self.assertEqual(
            self.cmd("CONFIG SET maxmemory not-int"),
            "(error) ERR value is not an integer or out of range",
        )
        self.assertEqual(self.cmd("CONFIG SET maxmemory 3"), "OK")
        self.assertEqual(
            self.cmd("SET k 1234"),
            "(error) OOM command not allowed when used memory > 'maxmemory'",
        )


class TestMiniRedisRepl(unittest.TestCase):
    """실제 python -m mini_redis 프로세스를 띄워 REPL 동작을 검증한다."""

    def test_repl_subprocess_integration(self) -> None:
        """stdin/stdout 기반 상호작용이 프롬프트와 함께 정상 동작해야 한다."""
        env = os.environ.copy()
        project_root = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
        python_path = env.get("PYTHONPATH", "")
        if python_path:
            env["PYTHONPATH"] = project_root + os.pathsep + python_path
        else:
            env["PYTHONPATH"] = project_root

        process = subprocess.Popen(
            [sys.executable, "-m", "mini_redis"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            cwd=project_root,
            env=env,
        )

        try:
            commands = "SET user:1 Alice\nGET user:1\nKEYS\nquit\n"
            stdout, stderr = process.communicate(commands, timeout=5)
        finally:
            if process.poll() is None:
                process.kill()
                process.wait(timeout=5)

        self.assertEqual(process.returncode, 0, msg=stderr)
        normalized = _normalize_lines(stdout)
        self.assertIn("mini-redis>", normalized)
        self.assertIn("OK", normalized)
        self.assertIn('"Alice"', normalized)
        self.assertIn('"user:1"', normalized)


