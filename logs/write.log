        테스트에서 시간을 고정하거나 제어할 수 있어야 TTL 동작을 안정적으로 검증할 수 있으므로
        현재 시각 공급 함수를 주입 가능하게 둔다. 실제 데이터, TTL 인덱스, LRU 노드 참조를
        각각 분리해 보관하는 이유는 조회는 빠르게 유지하면서도 만료와 축출을 서로 독립적으로
        처리하기 위해서이다. 최대 메모리가 0이면 제한 없음으로 간주하며, 축출 통계는 이후의
        메모리 정책 검증을 위해 누적 카운터로 유지한다.
        """
        self._now_fn = now_fn if now_fn is not None else time.time

        self._data: HashMap = HashMap()
        self._ttl_map: HashMap = HashMap()
        self._lru_nodes: HashMap = HashMap()
        self._lru_list: DoublyLinkedList = DoublyLinkedList()
        self._ttl_heap: MinHeap = MinHeap()

        self._used_memory: int = 0
        self._maxmemory: int = 0
        self._evicted_keys: int = 0

    def set(self, key: str, value: str) -> None:
        """키에 값을 저장하고 필요하면 TTL 제거와 LRU 갱신, 메모리 축출을 수행한다.

        쓰기 직전에 만료 데이터를 먼저 정리해야 메모리 계산과 축출 판단이 오래된 상태에
        오염되지 않는다. 새 엔트리 하나가 최대 메모리보다 큰 경우는 어떤 축출로도 수용할 수
        없으므로 즉시 OOMError를 발생시킨다. 기존 키를 덮어쓸 때는 이전 값의 메모리만큼 먼저
        차감해야 사용량이 실제 바이트 수와 일치한다. SET은 기존 TTL을 제거하는 Redis 계열
        동작을 따르므로 ttl_map에서 키를 삭제한다. 접근 순서를 최신으로 만들기 위해 LRU 리스트
        맨 앞으로 이동시키며, 삽입 후 메모리 제한을 넘으면 LRU 기준으로 축출한다. 다만 축출
        과정에서 방금 쓴 키까지 제거되어도 제한을 만족할 수 없는 경우가 있으므로, 예외가
        발생하면 부분적으로 남은 흔적을 정리해 저장소 상태를 일관되게 되돌린 뒤 예외를 다시
        전달한다.
        """
        self._purge_expired()

        new_entry_size = self._entry_size(key, value)
        if self._maxmemory > 0 and new_entry_size > self._maxmemory:
            raise OOMError()

        old_value = self._data.get(key)
        old_exists = old_value is not None

        if old_exists:
            self._used_memory -= self._entry_size(key, old_value)

        self._data.put(key, value)
        self._used_memory += new_entry_size

        if self._ttl_map.contains(key):
            self._ttl_map.remove(key)

        lru_node = self._lru_nodes.get(key)
        if lru_node is None:
            new_node = self._lru_list.insert_front(key)
            self._lru_nodes.put(key, new_node)
        else:
            self._lru_list.move_to_front(lru_node)

        try:
            self._evict_if_needed()
        except OOMError:
            if self._data.contains(key):
                self._delete_key_internal(key)
            raise

    def get(self, key: str) -> str | None:
        """키 값을 조회하고 존재하면 LRU 순서를 최신으로 갱신한다.

        조회 전에 만료 여부를 확인해야 이미 시한이 지난 데이터를 읽는 문제를 막을 수 있다.
        TTL이 지난 키는 조회 성공이 아니라 없는 키처럼 None을 반환한다. 값이 실제로 존재할 때만
        LRU 리스트의 맨 앞으로 이동시키는 이유는 최근 사용 정책이 읽기 접근을 반영해야 이후
        메모리 압박 시 덜 최근의 키가 우선 축출되도록 하기 위해서이다.
        """
        if self._is_expired(key):
            return None

        value = self._data.get(key)
        if value is None:
            return None

        lru_node = self._lru_nodes.get(key)
        if lru_node is not None:
            self._lru_list.move_to_front(lru_node)

        return value

    def delete(self, key: str) -> int:
        """키를 삭제하고 실제로 제거했으면 1, 없으면 0을 반환한다.

        TTL이 이미 지난 키는 논리적으로 존재하지 않는 것으로 취급해야 하므로 먼저 만료 여부를
        확인한다. 저장소에 없는 키를 지우려 할 때 0을 반환하는 것은 호출자가 삭제 성공 여부를
        구분할 수 있게 하기 위함이다. 실제 삭제는 데이터, TTL, LRU 참조를 함께 정리하는 내부
        루틴으로 위임해 중복 로직으로 인한 상태 불일치를 막는다.
        """
        if self._is_expired(key):
            return 0

        if not self._data.contains(key):
            return 0

        self._delete_key_internal(key)
        return 1

    def exists(self, key: str) -> int:
        """키가 현재 유효하게 존재하면 1, 아니면 0을 반환한다.

        단순 존재 검사라도 TTL을 무시하면 만료된 키가 살아 있는 것처럼 보일 수 있으므로
        먼저 만료 정리를 거친다. 반환값을 불리언이 아니라 정수로 유지하는 이유는 Redis류
        명령 결과 형식과 맞추기 위해서이다.
        """
        if self._is_expired(key):
            return 0
        if self._data.contains(key):
            return 1
        return 0

    def dbsize(self) -> int:
        """만료를 반영한 현재 데이터 개수를 반환한다.

        크기 조회 전에 만료 키를 제거해야 호출 시점의 논리적 데이터 수와 내부 저장 수가
        어긋나지 않는다. 별도 카운터 대신 해시맵 size를 그대로 사용하는 것은 실제 엔트리
        상태를 단일 진실 원천으로 유지하기 위해서이다.
        """
        self._purge_expired()
        return self._data.size()

    def keys(self) -> list[str]:
        """만료를 반영한 현재 키 목록을 반환한다.

        만료된 키가 목록에 섞이면 존재 검사나 TTL 결과와 모순되므로 먼저 만료를 정리한다.
        이후 해시맵이 보유한 키 집합을 그대로 반환해 현재 시점의 논리적 데이터 스냅샷을 제공한다.
        """
        self._purge_expired()
        return self._data.keys()

    def set_maxmemory(self, bytes_limit: int) -> None:
        """최대 메모리 제한을 설정하고 필요하면 즉시 축출을 수행한다.

        제한값이 바뀐 뒤 나중까지 초과 상태를 방치하면 이후 연산의 의미가 불명확해지므로
        설정 직후 현재 상태를 새 정책에 맞춘다. 먼저 만료 키를 정리하는 이유는 살아 있는
        데이터만으로 실제 초과 여부를 판단해야 불필요한 LRU 축출을 줄일 수 있기 때문이다.
        0 이하가 들어오면 제한 없음처럼 동작하도록 _evict_if_needed의 규칙에 위임한다.
        """
        self._maxmemory = bytes_limit
        self._purge_expired()
        self._evict_if_needed()

    def info_memory(self) -> tuple[int, int, int]:
        """메모리 사용량, 최대 메모리, 누적 축출 수를 반환한다.

        통계 조회라도 만료 데이터를 포함한 사용량은 현재 상태를 왜곡하므로 먼저 정리한다.
        반환 튜플의 순서를 고정하는 이유는 호출자가 별도 키 이름 없이도 예측 가능하게
        파싱할 수 있어야 하기 때문이다.
        """
        self._purge_expired()
        return (self._used_memory, self._maxmemory, self._evicted_keys)

    def expire(self, key: str, seconds: int) -> int:
        """키에 TTL을 설정하고 성공 시 1, 실패 시 0을 반환한다.

        이미 만료된 키나 존재하지 않는 키에는 TTL을 설정할 수 없으므로 0을 반환한다.
        seconds가 0 이하이면 미래 시각을 저장하는 대신 즉시 삭제로 처리해야 호출자의 의도인
        즉시 만료가 명확하게 반영된다. 양수 TTL은 현재 시각에 더해 절대 만료 시각으로 저장하며,
        힙에는 같은 키의 과거 TTL 기록이 남을 수 있다. 그 중복을 즉시 제거하지 않는 이유는
        힙 내부 임의 삭제보다 삽입과 지연 정리가 단순하고 안전하기 때문이다. 이후 purge 단계에서
        ttl_map의 최신 값과 대조해 오래된 힙 항목을 무시한다.
        """
        if self._is_expired(key):
            return 0

        if not self._data.contains(key):
            return 0

        if seconds <= 0:
            self._delete_key_internal(key)
            return 1

        expire_at = float(self._now_fn()) + float(seconds)
        self._ttl_map.put(key, expire_at)
        self._ttl_heap.push((expire_at, key))
        return 1

    def ttl(self, key: str) -> int:
        """키의 남은 TTL을 정수 초로 반환한다.

        키가 없거나 조회 시점에 이미 만료되었으면 -2를 반환하고, TTL이 설정되지 않았으면 -1을
        반환한다. 이 구분은 호출자가 키 부재와 영속 키를 다르게 처리할 수 있게 하기 위해 필요하다.
        남은 시간은 ceil을 사용해 올림하는데, 이는 아직 유효한 잔여 시간을 0으로 과소평가하지 않게
        하려는 선택이다. 다만 음수는 0으로 보정해 경계 시각 직전의 부동소수 오차가 사용자에게
        혼란스러운 음수 TTL로 보이지 않게 한다.
        """
        if self._is_expired(key):
            return -2

        if not self._data.contains(key):
            return -2

        expire_at = self._ttl_map.get(key)
        if expire_at is None:
            return -1

        remaining = max(0, int(math.ceil(expire_at - float(self._now_fn()))))
        return remaining

    def _is_expired(self, key: str) -> bool:
        """주어진 키가 현재 시각 기준으로 만료되었는지 확인한다.

        먼저 전역 purge를 수행하는 이유는 힙에 쌓인 더 이른 만료 항목들을 선행 정리해
        저장소 전체 상태를 최신화하기 위해서이다. 이후 ttl_map에서 해당 키의 현재 만료 시각을
        읽어 직접 비교한다. 이중 확인이 필요한 이유는 힙에 남은 오래된 TTL 기록만으로는
        현재 키의 실제 만료 상태를 단정할 수 없기 때문이다. 만료가 확인되면 즉시 내부 삭제를
        수행해 이후 같은 키에 대한 연산이 일관되게 없는 키처럼 동작하도록 만든다.
        """
        self._purge_expired()

        expire_at = self._ttl_map.get(key)
        if expire_at is None:
            return False

        now = float(self._now_fn())
        if expire_at <= now:
            self._delete_key_internal(key)
            return True

        return False

    def _evict_if_needed(self) -> None:
        """사용 메모리가 제한을 넘는 동안 LRU 기준으로 키를 축출한다.

        축출 전에 만료 키를 먼저 제거해야 실제 살아 있는 데이터만으로 메모리 부족 여부를
        판단할 수 있다. 최대 메모리가 0 이하이면 제한이 없으므로 아무 동작도 하지 않는다.
        초과 상태가 해소될 때까지 LRU 리스트의 뒤쪽, 즉 가장 오래 사용되지 않은 키부터 제거한다.
        리스트와 해시맵, TTL 인덱스를 함께 정리해야 이후 조회와 만료 처리에서 유령 엔트리가
        남지 않는다. 만약 메모리는 초과했는데 제거할 LRU 노드가 없으면 내부 상태가 이미
        모순된 것이므로 조용히 넘어가지 않고 OOMError를 발생시켜 문제를 드러낸다. 축출된 키 수는
        정책 효과를 관찰할 수 있도록 누적 통계에 반영한다.
        """
        self._purge_expired()

        if self._maxmemory <= 0:
            return

        while self._used_memory > self._maxmemory:
            lru_key = self._lru_list.remove_back()
            if lru_key is None:
                raise OOMError()

            self._lru_nodes.remove(lru_key)
            if self._data.contains(lru_key):
                value = self._data.get(lru_key)
                if value is not None:
                    self._used_memory -= self._entry_size(lru_key, value)
                self._data.remove(lru_key)
                if self._ttl_map.contains(lru_key):
                    self._ttl_map.remove(lru_key)
                self._evicted_keys += 1

    def _entry_size(self, key: str, value: str) -> int:
        """키와 값의 UTF-8 바이트 길이 합으로 엔트리 메모리 크기를 계산한다.

        문자열의 문자 수가 아니라 바이트 수를 사용해야 한글 등 멀티바이트 문자가 포함된 경우에도
        실제 저장 비용에 더 가까운 추정을 할 수 있다. 객체 헤더나 인덱스 오버헤드는 제외하는데,
        이 저장소의 메모리 정책을 단순하고 결정적으로 유지하기 위해서이다.
        """
        return len(key.encode("utf-8")) + len(value.encode("utf-8"))

    def _delete_key_internal(self, key: str) -> None:
        """키와 관련된 데이터, TTL, LRU 상태를 내부적으로 모두 제거한다.

        삭제 로직이 여러 공개 메서드에 흩어지면 메모리 차감이나 LRU 노드 제거 중 하나가 빠져
        상태 불일치가 생기기 쉽기 때문에 공통 루틴으로 묶는다. 값이 실제로 존재할 때만 메모리를
        차감하는 이유는 중복 삭제 호출에도 사용량이 음수로 흐트러지지 않게 하기 위해서이다.
        TTL 정보와 LRU 노드 참조도 함께 제거해야 이후 purge나 move 동작이 이미 사라진 키를
        다시 만지지 않게 된다.
        """
        value = self._data.get(key)
        if value is not None:
            self._used_memory -= self._entry_size(key, value)
            self._data.remove(key)

        if self._ttl_map.contains(key):
            self._ttl_map.remove(key)

        lru_node = self._lru_nodes.get(key)
        if lru_node is not None:
            self._lru_list.remove_node(lru_node)
            self._lru_nodes.remove(key)

