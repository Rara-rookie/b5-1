                current_chars = []
            i += 1
            continue

        if ch == '"':
            if current_chars:
                tokens.append("".join(current_chars))
                current_chars = []
            in_quotes = True
            i += 1
            continue

        current_chars.append(ch)
        i += 1

    if current_chars:
