            if len(tokens) != 2:
                raise WrongArgsError(command)
            result = store.delete(tokens[1])
            return "(integer) " + str(result)

        if upper_command == "EXISTS":
            if len(tokens) != 2:
                raise WrongArgsError(command)
            result = store.exists(tokens[1])
            return "(integer) " + str(result)

        if upper_command == "DBSIZE":
            if len(tokens) != 1:
                raise WrongArgsError(command)
            result = store.dbsize()
            return "(integer) " + str(result)

        if upper_command == "KEYS":
