import subprocess
import sys
import time
import unittest

from mini_redis.hashmap import HashMap
from mini_redis.heap import MinHeap
from mini_redis.linked_list import DoublyLinkedList


class FakeClock:
    """테스트가 시간 흐름을 결정적으로 제어하기 위한 가짜 시계이다."""

    def __init__(self, start: float = 0.0) -> None:
        """초기 시각을 설정한다."""
        self.current = start

    def now(self) -> float:
        """현재 시각을 반환한다."""
        return self.current

    def advance(self, seconds: float) -> None:
        """테스트가 원하는 만큼 시간을 전진시킨다."""
        self.current += seconds


class MiniRedisAdapter:
    """구현마다 다른 진입점을 테스트에서 일관되게 다루기 위한 어댑터이다."""

    def __init__(self, now_fn=None) -> None:
        """가능한 생성 방식을 순서대로 시도해 테스트 대상을 준비한다."""
        from mini_redis import __dict__ as package_dict

        self.instance = None
        self.execute_method_name = None

        candidate_classes = []
        for name in (
            "MiniRedis",
            "Redis",
            "MiniRedisServer",
            "MiniRedisCLI",
            "Engine",
            "Database",
        ):
            obj = package_dict.get(name)
            if isinstance(obj, type):
                candidate_classes.append(obj)

        if not candidate_classes:
            try:
                from mini_redis.core import MiniRedis as CoreMiniRedis

                candidate_classes.append(CoreMiniRedis)
            except Exception:
                pass

        if not candidate_classes:
            try:
                from mini_redis.redis import MiniRedis as RedisMiniRedis

                candidate_classes.append(RedisMiniRedis)
            except Exception:
                pass

        if not candidate_classes:
            try:
                from mini_redis.cli import MiniRedis as CliMiniRedis

                candidate_classes.append(CliMiniRedis)
            except Exception:
                pass

        last_error = None
        for cls in candidate_classes:
            for kwargs in (
                {"now_fn": now_fn} if now_fn is not None else {},
                {},
            ):
                try:
                    self.instance = cls(**kwargs)
                    break
                except TypeError as exc:
                    last_error = exc
                    continue
                except Exception as exc:
                    last_error = exc
                    continue
            if self.instance is not None:
                break

        if self.instance is None:
            raise AssertionError(
                "Mini Redis 구현 인스턴스를 생성하지 못했습니다. "
                "mini_redis 패키지에 공개된 핵심 클래스를 확인하세요."
            ) from last_error

        for method_name in ("execute", "run_command", "handle_command", "process_command"):
            method = getattr(self.instance, method_name, None)
            if callable(method):
                self.execute_method_name = method_name
                break

        if self.execute_method_name is None:
            raise AssertionError(
                "명령 실행 메서드를 찾지 못했습니다. "
                "execute/run_command/handle_command/process_command 중 하나가 필요합니다."
            )

    def execute(self, command: str) -> str:
        """문자열 명령을 실행하고 문자열 결과를 반환한다."""
        method = getattr(self.instance, self.execute_method_name)
        result = method(command)
        if result is None:
            return ""
        return str(result)


class ForcedCollisionHashMap(HashMap):
    """체이닝 충돌 동작을 강제로 검증하기 위한 테스트 전용 해시맵이다."""

    def _hash(self, key: str) -> int:
        """모든 키를 같은 버킷으로 보내 충돌 처리 경로를 확실히 통과시킨다."""
        return 0


class DoublyLinkedListTest(unittest.TestCase):
    """이중 연결 리스트의 핵심 연산과 경계 조건을 검증한다."""

    def test_insert_front_and_back_preserve_links(self) -> None:
        """앞뒤 삽입이 head, tail, prev, next를 올바르게 연결하는지 확인한다."""
        linked = DoublyLinkedList()

        first = linked.insert_front("b")
        second = linked.insert_front("a")
        third = linked.insert_back("c")

        self.assertIs(linked.head, second)
        self.assertIs(linked.tail, third)
        self.assertIsNone(second.prev)
        self.assertIs(second.next, first)
        self.assertIs(first.prev, second)
        self.assertIs(first.next, third)
        self.assertIs(third.prev, first)
        self.assertIsNone(third.next)

    def test_remove_front_and_back_on_empty_and_non_empty(self) -> None:
        """빈 리스트와 일반 리스트에서 앞뒤 제거 결과를 확인한다."""
        linked = DoublyLinkedList()

        self.assertIsNone(linked.remove_front())
        self.assertIsNone(linked.remove_back())

        linked.insert_back("x")
        linked.insert_back("y")
        linked.insert_back("z")

        self.assertEqual(linked.remove_front(), "x")
        self.assertEqual(linked.remove_back(), "z")
        self.assertEqual(linked.remove_front(), "y")
        self.assertIsNone(linked.head)
        self.assertIsNone(linked.tail)
        self.assertIsNone(linked.remove_back())

    def test_remove_node_handles_middle_head_tail_singleton(self) -> None:
        """임의 노드 제거가 위치와 관계없이 리스트 일관성을 유지하는지 확인한다."""
        linked = DoublyLinkedList()
        node_a = linked.insert_back("a")
        node_b = linked.insert_back("b")
        node_c = linked.insert_back("c")

        linked.remove_node(node_b)
        self.assertIs(linked.head, node_a)
        self.assertIs(linked.tail, node_c)
        self.assertIs(node_a.next, node_c)
        self.assertIs(node_c.prev, node_a)
        self.assertIsNone(node_b.prev)
        self.assertIsNone(node_b.next)

        linked.remove_node(node_a)
        self.assertIs(linked.head, node_c)
        self.assertIs(linked.tail, node_c)
        self.assertIsNone(node_c.prev)

        linked.remove_node(node_c)
        self.assertIsNone(linked.head)
        self.assertIsNone(linked.tail)

    def test_move_to_front_moves_middle_and_tail_and_keeps_head(self) -> None:
        """앞으로 이동 연산이 재삽입 없이 포인터만 재배치하는 결과를 검증한다."""
        linked = DoublyLinkedList()
        node_a = linked.insert_back("a")
        node_b = linked.insert_back("b")
        node_c = linked.insert_back("c")

        linked.move_to_front(node_b)
        self.assertIs(linked.head, node_b)
        self.assertIs(linked.tail, node_c)
        self.assertEqual(linked.head.data, "b")
        self.assertEqual(linked.head.next.data, "a")
        self.assertEqual(linked.tail.prev.data, "a")

        linked.move_to_front(node_c)
        self.assertIs(linked.head, node_c)
        self.assertIs(linked.tail, node_a)
        self.assertEqual(linked.head.next.data, "b")

        linked.move_to_front(node_c)
        self.assertIs(linked.head, node_c)
        self.assertIsNone(linked.head.prev)
        self.assertEqual(linked.tail.data, "a")


class HashMapTest(unittest.TestCase):
    """체이닝 기반 해시맵의 동작과 리사이즈를 검증한다."""

    def test_hash_returns_index_within_capacity(self) -> None:
        """해시 함수가 언제나 유효한 버킷 인덱스를 반환하는지 확인한다."""
        hashmap = HashMap()
        for key in ("a", "abc", "user:1", "한글", "long-key-value-1234567890"):
            index = hashmap._hash(key)
            self.assertGreaterEqual(index, 0)
            self.assertLess(index, hashmap._capacity)

    def test_chaining_collision_resolution(self) -> None:
        """같은 버킷으로 몰린 키들이 서로 덮어쓰지 않고 공존하는지 확인한다."""
        hashmap = ForcedCollisionHashMap()
        hashmap.put("alpha", 1)
        hashmap.put("beta", 2)
        hashmap.put("gamma", 3)

        self.assertEqual(hashmap.get("alpha"), 1)
        self.assertEqual(hashmap.get("beta"), 2)
        self.assertEqual(hashmap.get("gamma"), 3)
        self.assertEqual(hashmap.size(), 3)

        self.assertTrue(hashmap.contains("alpha"))
        self.assertTrue(hashmap.contains("beta"))
        self.assertTrue(hashmap.contains("gamma"))

        self.assertTrue(hashmap.remove("beta"))
        self.assertFalse(hashmap.contains("beta"))
        self.assertEqual(hashmap.get("beta"), None)
        self.assertEqual(hashmap.size(), 2)

    def test_resize_doubles_capacity_from_8_to_16(self) -> None:
        """로드 팩터가 0.75를 넘는 순간 버킷 수가 두 배가 되는지 검증한다."""
        hashmap = HashMap(initial_capacity=8)
        for index in range(7):
            hashmap.put(f"key:{index}", index)

        self.assertEqual(hashmap._capacity, 16)
        for index in range(7):
            self.assertEqual(hashmap.get(f"key:{index}"), index)

    def test_put_get_remove_contains_keys_size(self) -> None:
        """기본 해시맵 API가 요구한 의미를 만족하는지 확인한다."""
        hashmap = HashMap()
        hashmap.put("k1", "v1")
        hashmap.put("k2", "v2")
        hashmap.put("k1", "v1-new")

        self.assertEqual(hashmap.get("k1"), "v1-new")
        self.assertEqual(hashmap.get("k2"), "v2")
        self.assertIsNone(hashmap.get("missing"))
        self.assertTrue(hashmap.contains("k1"))
        self.assertFalse(hashmap.contains("missing"))
        self.assertEqual(hashmap.size(), 2)

        keys = hashmap.keys()
        self.assertIn("k1", keys)
        self.assertIn("k2", keys)
        self.assertEqual(len(keys), 2)

        self.assertTrue(hashmap.remove("k2"))
        self.assertFalse(hashmap.remove("k2"))
        self.assertFalse(hashmap.contains("k2"))
        self.assertEqual(hashmap.size(), 1)


class MinHeapTest(unittest.TestCase):
    """최소 힙이 TTL 우선순위를 올바르게 유지하는지 검증한다."""

    def test_push_peek_pop_size_and_order(self) -> None:
        """삽입, 조회, 제거가 최소 만료 시각 순서를 보장하는지 확인한다."""
        heap = MinHeap()
        self.assertEqual(heap.size(), 0)
        self.assertIsNone(heap.peek())
        self.assertIsNone(heap.pop())

        heap.push((30.0, "k3"))
        heap.push((10.0, "k1"))
        heap.push((20.0, "k2"))
        heap.push((10.0, "k1b"))

        self.assertEqual(heap.size(), 4)
        self.assertEqual(heap.peek(), (10.0, "k1"))

        popped = [heap.pop(), heap.pop(), heap.pop(), heap.pop()]
        self.assertEqual(
            popped,
            [(10.0, "k1"), (10.0, "k1b"), (20.0, "k2"), (30.0, "k3")],
        )
        self.assertEqual(heap.size(), 0)
        self.assertIsNone(heap.pop())


