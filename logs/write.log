        정리 없이 크기만 읽으면 힙에는 만료 정보가 있으나 데이터에도 아직 남아 있는
        지연 삭제 항목이 카운트될 수 있으므로 먼저 purge를 수행한다.
        """
        self._purge_expired()
        return self._data.size()

    def keys(self) -> list[str]:
        """만료 정리 후 현재 유효한 모든 키 목록을 반환한다.

        지연 삭제 구조에서는 만료된 키가 내부 해시맵에 잠시 남아 있을 수 있으므로
