                raise WrongArgsError(command)
            keys = store.keys()
            if len(keys) == 0:
                return "(empty array)"
            lines: list[str] = []
            index = 1
            for key in keys:
                lines.append(str(index) + '. "' + key + '"')
                index += 1
            return "\n".join(lines)

        if upper_command == "CONFIG":
            if len(tokens) != 4:
                raise WrongArgsError(command)
