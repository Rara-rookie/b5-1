class FakeClock:
    """테스트가 시간 흐름을 결정적으로 제어하도록 돕는 가짜 시계이다."""

    def __init__(self, start: float = 0.0) -> None:
        """초기 시각을 설정한다."""
        self.current = start

    def now(self) -> float:
        """현재 시각을 반환한다."""
        return self.current

    def advance(self, seconds: float) -> None:
        """테스트가 원하는 만큼 시간을 전진시킨다."""
        self.current += seconds


class BadHashKey:
    """같은 해시값을 강제로 만들어 체이닝 충돌 처리를 검증하는 테스트 키이다."""

    def __init__(self, name: str, forced_hash: int) -> None:
        """표시용 이름과 강제 해시값을 저장한다."""
        self.name = name
        self.forced_hash = forced_hash

    def __hash__(self) -> int:
        """충돌 시나리오를 재현하기 위해 같은 해시값을 돌려준다."""
        return self.forced_hash

    def __eq__(self, other: object) -> bool:
        """충돌한 키들이 이름으로 구분되도록 한다."""
        if not isinstance(other, BadHashKey):
            return False
        return self.name == other.name and self.forced_hash == other.forced_hash

    def __repr__(self) -> str:
        """실패 시 어떤 키인지 빠르게 식별할 수 있게 한다."""
        return self.name


class DoublyLinkedListTestCase(unittest.TestCase):
    """이중 연결 리스트의 O(1) 조작 계약을 검증한다."""

    def test_insert_front_and_back_build_expected_order(self) -> None:
        """양끝 삽입이 연결 관계와 순서를 정확히 만든다."""
        linked = DoublyLinkedList()

        first = linked.insert_front("b")
        second = linked.insert_front("a")
        third = linked.insert_back("c")

        self.assertIsInstance(first, Node)
        self.assertIsInstance(second, Node)
        self.assertIsInstance(third, Node)

        self.assertEqual(linked.head.data, "a")
        self.assertEqual(linked.head.next.data, "b")
        self.assertEqual(linked.tail.data, "c")
        self.assertEqual(linked.tail.prev.data, "b")

    def test_remove_front_and_back_on_empty_and_non_empty(self) -> None:
        """비어 있는 경우와 값이 있는 경우 모두 안전하게 동작해야 한다."""
        linked = DoublyLinkedList()

        self.assertIsNone(linked.remove_front())
        self.assertIsNone(linked.remove_back())

        linked.insert_back("a")
        linked.insert_back("b")
        linked.insert_back("c")

        self.assertEqual(linked.remove_front(), "a")
        self.assertEqual(linked.remove_back(), "c")
        self.assertEqual(linked.remove_back(), "b")
        self.assertIsNone(linked.remove_front())
        self.assertIsNone(linked.head)
        self.assertIsNone(linked.tail)

    def test_remove_node_handles_middle_head_tail_and_singleton(self) -> None:
        """임의 노드 삭제가 경계 위치마다 연결 불일치를 남기지 않아야 한다."""
        linked = DoublyLinkedList()
        n1 = linked.insert_back("a")
        n2 = linked.insert_back("b")
        n3 = linked.insert_back("c")

        linked.remove_node(n2)
        self.assertEqual(linked.head.data, "a")
        self.assertEqual(linked.tail.data, "c")
        self.assertIs(linked.head.next, linked.tail)
        self.assertIs(linked.tail.prev, linked.head)

        linked.remove_node(n1)
        self.assertEqual(linked.head.data, "c")
        self.assertEqual(linked.tail.data, "c")

        linked.remove_node(n3)
        self.assertIsNone(linked.head)
        self.assertIsNone(linked.tail)

    def test_move_to_front_updates_recency_order(self) -> None:
        """LRU 핵심 전제인 최근 사용 승격이 정확히 재배치되어야 한다."""
        linked = DoublyLinkedList()
        n1 = linked.insert_back("a")
        n2 = linked.insert_back("b")
        n3 = linked.insert_back("c")

        linked.move_to_front(n2)
        self.assertEqual(linked.head.data, "b")
        self.assertEqual(linked.head.next.data, "a")
        self.assertEqual(linked.tail.data, "c")

        linked.move_to_front(n3)
        self.assertEqual(linked.head.data, "c")
        self.assertEqual(linked.head.next.data, "b")
        self.assertEqual(linked.tail.data, "a")

        linked.move_to_front(linked.head)
        self.assertEqual(linked.head.data, "c")
        self.assertEqual(linked.tail.data, "a")


class HashMapTestCase(unittest.TestCase):
    """체이닝 해시맵의 충돌 처리와 확장 정책을 검증한다."""

    def test_hash_index_is_within_capacity_range(self) -> None:
        """버킷 인덱스가 언제나 유효 범위 안에 있어야 접근 오류를 막을 수 있다."""
        hashmap = HashMap()
        samples = ["alpha", "beta", "gamma", "delta", "epsilon", "zeta"]

        for key in samples:
            index = hashmap._hash(key)
            self.assertGreaterEqual(index, 0)
            self.assertLess(index, hashmap._capacity)

    def test_chaining_collision_put_get_remove_contains(self) -> None:
        """같은 버킷 충돌이 있어도 항목별 식별과 삭제가 유지되어야 한다."""
        hashmap = HashMap()
        key1 = BadHashKey("k1", 7)
        key2 = BadHashKey("k2", 7)
        key3 = BadHashKey("k3", 7)

        hashmap.put(key1, "v1")
        hashmap.put(key2, "v2")
        hashmap.put(key3, "v3")

        self.assertTrue(hashmap.contains(key1))
        self.assertTrue(hashmap.contains(key2))
        self.assertTrue(hashmap.contains(key3))
        self.assertEqual(hashmap.get(key1), "v1")
        self.assertEqual(hashmap.get(key2), "v2")
        self.assertEqual(hashmap.get(key3), "v3")
        self.assertEqual(hashmap.size(), 3)

        removed = hashmap.remove(key2)
        self.assertEqual(removed, "v2")
        self.assertFalse(hashmap.contains(key2))
        self.assertEqual(hashmap.get(key1), "v1")
        self.assertEqual(hashmap.get(key3), "v3")
        self.assertEqual(hashmap.size(), 2)

    def test_resize_doubles_capacity_when_load_factor_exceeds_threshold(self) -> None:
        """확장이 일어나지 않으면 체이닝 길이가 길어져 성능 계약이 무너질 수 있다."""
        hashmap = HashMap()
        self.assertEqual(hashmap._capacity, 8)

        for i in range(7):
            hashmap.put("key" + str(i), "value" + str(i))

        self.assertEqual(hashmap._capacity, 16)
        self.assertEqual(hashmap.size(), 7)

        for i in range(7):
            self.assertEqual(hashmap.get("key" + str(i)), "value" + str(i))

    def test_keys_and_size_reflect_current_entries(self) -> None:
        """외부 관찰용 메서드들이 삭제 후 상태를 정확히 반영해야 한다."""
        hashmap = HashMap()
        hashmap.put("a", "1")
        hashmap.put("b", "2")
        hashmap.put("c", "3")

        keys = hashmap.keys()
        self.assertEqual(hashmap.size(), 3)
        self.assertEqual(sorted(keys), ["a", "b", "c"])

        hashmap.remove("b")
        self.assertEqual(hashmap.size(), 2)
        self.assertEqual(sorted(hashmap.keys()), ["a", "c"])


class MinHeapTestCase(unittest.TestCase):
    """TTL 만료 시각 관리에 필요한 최소 힙 순서를 검증한다."""

    def test_push_peek_pop_and_size_follow_min_order(self) -> None:
        """가장 빠른 만료를 우선 확인할 수 있어야 TTL 정리가 효율적이다."""
        heap = MinHeap()

        self.assertEqual(heap.size(), 0)
        self.assertIsNone(heap.peek())
        self.assertIsNone(heap.pop())

        heap.push((30, "k3"))
        heap.push((10, "k1"))
        heap.push((20, "k2"))

        self.assertEqual(heap.size(), 3)
        self.assertEqual(heap.peek(), (10, "k1"))
        self.assertEqual(heap.pop(), (10, "k1"))
        self.assertEqual(heap.pop(), (20, "k2"))
        self.assertEqual(heap.pop(), (30, "k3"))
        self.assertEqual(heap.size(), 0)
        self.assertIsNone(heap.pop())


class CommandAndStoreTestCase(unittest.TestCase):
    """문자열 명령어, 메모리 정책, TTL 정책을 통합 검증한다."""

    def setUp(self) -> None:
        """각 테스트가 서로의 저장 상태에 영향을 주지 않게 분리한다."""
        self.clock = FakeClock(100.0)
        self.store = MiniRedisStore(now_fn=self.clock.now)

    def run_cmd(self, line: str) -> str:
        """실제 CLI 경로와 같은 파서+실행기 조합으로 결과를 얻는다."""
        return execute(self.store, tokenize(line))

    def test_string_commands_and_empty_keys_output(self) -> None:
        """기본 6개 명령어가 과제의 관찰 가능한 계약을 충족해야 한다."""
        self.assertEqual(self.run_cmd("DBSIZE"), "(integer) 0")
        self.assertEqual(self.run_cmd("KEYS"), "(empty array)")
        self.assertEqual(self.run_cmd('SET user:1 "Alice Smith"'), "OK")
        self.assertEqual(self.run_cmd("GET user:1"), '"Alice Smith"')
        self.assertEqual(self.run_cmd("EXISTS user:1"), "(integer) 1")
        self.assertEqual(self.run_cmd("DBSIZE"), "(integer) 1")
        self.assertEqual(self.run_cmd("KEYS"), '1. "user:1"')
        self.assertEqual(self.run_cmd("DEL user:1"), "(integer) 1")
        self.assertEqual(self.run_cmd("GET user:1"), "(nil)")
        self.assertEqual(self.run_cmd("EXISTS user:1"), "(integer) 0")
        self.assertEqual(self.run_cmd("DEL user:1"), "(integer) 0")
        self.assertEqual(self.run_cmd("KEYS"), "(empty array)")

    def test_memory_limit_lru_eviction_and_info_output(self) -> None:
        """과제 예시 수치가 맞아야 used_memory와 축출 흐름 설명이 성립한다."""
        self.assertEqual(self.run_cmd("CONFIG SET maxmemory 30"), "OK")
        self.assertEqual(self.run_cmd('SET user:1 "aaaaa"'), "OK")
        self.assertEqual(self.run_cmd('SET user:2 "bbbbb"'), "OK")
        self.assertEqual(self.run_cmd('SET user:3 "ccccc"'), "OK")

        self.assertEqual(self.run_cmd("GET user:1"), "(nil)")
        self.assertEqual(
            self.run_cmd("INFO memory"),
            "used_memory:22\nmaxmemory:30\nevicted_keys:1",
        )
        self.assertEqual(self.run_cmd("GET user:2"), '"bbbbb"')
        self.assertEqual(self.run_cmd("GET user:3"), '"ccccc"')

    def test_get_success_updates_lru_so_different_key_is_evicted(self) -> None:
        """조회 성공 시에만 최근 사용 갱신이 일어나야 LRU 정책이 정확해진다."""
        self.assertEqual(self.run_cmd("CONFIG SET maxmemory 30"), "OK")
        self.assertEqual(self.run_cmd('SET user:1 "aaaaa"'), "OK")
        self.assertEqual(self.run_cmd('SET user:2 "bbbbb"'), "OK")
        self.assertEqual(self.run_cmd("GET user:1"), '"aaaaa"')
        self.assertEqual(self.run_cmd('SET user:3 "ccccc"'), "OK")

        self.assertEqual(self.run_cmd("GET user:1"), '"aaaaa"')
        self.assertEqual(self.run_cmd("GET user:2"), "(nil)")
        self.assertEqual(self.run_cmd("GET user:3"), '"ccccc"')
        self.assertEqual(
            self.run_cmd("INFO memory"),
            "used_memory:22\nmaxmemory:30\nevicted_keys:1",
        )

    def test_single_entry_larger_than_maxmemory_returns_oom_and_does_not_store(self) -> None:
        """축출로 해결 불가능한 단일 초과 항목은 부분 반영 없이 거절되어야 한다."""
        self.assertEqual(self.run_cmd("CONFIG SET maxmemory 5"), "OK")
        self.assertEqual(self.run_cmd('SET abcdef "g"'), "(error) OOM command not allowed when used memory > 'maxmemory'")
        self.assertEqual(self.run_cmd("DBSIZE"), "(integer) 0")
        self.assertEqual(
            self.run_cmd("INFO memory"),
            "used_memory:0\nmaxmemory:5\nevicted_keys:0",
        )

    def test_ttl_values_expiration_and_get_nil_without_lru_refresh(self) -> None:
        """만료 판정은 조회 전에 일어나야 하고 만료 키는 최근 사용으로 승격되면 안 된다."""
        self.assertEqual(self.run_cmd("CONFIG SET maxmemory 30"), "OK")
        self.assertEqual(self.run_cmd('SET user:1 "aaaaa"'), "OK")
        self.assertEqual(self.run_cmd('SET user:2 "bbbbb"'), "OK")
        self.assertEqual(self.run_cmd("EXPIRE user:1 5"), "(integer) 1")
        self.assertEqual(self.run_cmd("TTL user:1"), "(integer) 5")
        self.clock.advance(3)
        self.assertEqual(self.run_cmd("TTL user:1"), "(integer) 2")
        self.clock.advance(3)
        self.assertEqual(self.run_cmd("TTL user:1"), "(integer) -2")
        self.assertEqual(self.run_cmd("GET user:1"), "(nil)")
        self.assertEqual(self.run_cmd('SET user:3 "ccccc"'), "OK")
        self.assertEqual(self.run_cmd("GET user:2"), "(nil)")
        self.assertEqual(self.run_cmd("GET user:3"), '"ccccc"')

    def test_ttl_minus_one_for_existing_key_without_expire_and_minus_two_for_missing(self) -> None:
        """TTL의 -1과 -2 구분은 클라이언트가 상태를 해석하는 핵심 신호이다."""
        self.assertEqual(self.run_cmd('SET alpha "1"'), "OK")
        self.assertEqual(self.run_cmd("TTL alpha"), "(integer) -1")
        self.assertEqual(self.run_cmd("TTL missing"), "(integer) -2")

    def test_set_overwrite_clears_existing_ttl(self) -> None:
        """덮어쓰기 후 TTL이 남아 있으면 Redis 계열 계약과 달라지므로 반드시 초기화되어야 한다."""
        self.assertEqual(self.run_cmd('SET session "v1"'), "OK")
        self.assertEqual(self.run_cmd("EXPIRE session 10"), "(integer) 1")
        self.assertEqual(self.run_cmd('SET session "v2"'), "OK")
        self.assertEqual(self.run_cmd("TTL session"), "(integer) -1")
        self.clock.advance(20)
        self.assertEqual(self.run_cmd("GET session"), '"v2"')

    def test_expire_non_positive_deletes_immediately(self) -> None:
        """0 이하 TTL은 지연 없이 삭제되어야 만료 규칙이 모호하지 않다."""
        self.assertEqual(self.run_cmd('SET temp "value"'), "OK")
        self.assertEqual(self.run_cmd("EXPIRE temp 0"), "(integer) 1")
        self.assertEqual(self.run_cmd("GET temp"), "(nil)")
