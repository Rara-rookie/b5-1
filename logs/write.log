        반환형을 정수로 고정하는 이유는 Redis 스타일 명령 결과와 맞추기 위해서이다.
        """
        if self._is_expired(key):
            return 0
        if self._data.contains(key):
            return 1
        return 0

    def dbsize(self) -> int:
