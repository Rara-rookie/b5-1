def tokenize(line: str) -> list[str]:
    tokens: list[str] = []
    current_chars: list[str] = []
    in_quotes = False
    i = 0
    length = len(line)

    while i < length:
        ch = line[i]

        if in_quotes:
            if ch == '"':
                tokens.append("".join(current_chars))
                current_chars = []
                in_quotes = False
            else:
                current_chars.append(ch)
            i += 1
            continue

        if ch.isspace():
            if current_chars:
                tokens.append("".join(current_chars))
                current_chars = []
            i += 1
            continue

        if ch == '"':
            if current_chars:
                tokens.append("".join(current_chars))
                current_chars = []
            in_quotes = True
            i += 1
            continue

        current_chars.append(ch)
        i += 1

    if current_chars:
        tokens.append("".join(current_chars))
    elif in_quotes:
        tokens.append("".join(current_chars))

    return tokens
