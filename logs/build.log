from .linked_list import DoublyLinkedList, Node


class HashMap:
    """Chaining hash map using doubly linked lists for buckets."""

    def __init__(self, initial_capacity: int = 8) -> None:
        capacity = initial_capacity
        if capacity < 1:
            capacity = 8
        self._capacity: int = capacity
        self._size: int = 0
        self._buckets: list[DoublyLinkedList] = [DoublyLinkedList() for _ in range(self._capacity)]

    def _hash(self, key: str) -> int:
        hash_value = 5381
        for char in key:
            hash_value = ((hash_value << 5) + hash_value) + ord(char)
        return hash_value % self._capacity

    def put(self, key: str, value: object) -> None:
        index = self._hash(key)
        bucket = self._buckets[index]

        current = bucket.head
        while current is not None:
            entry = current.data
            if entry[0] == key:
                current.data = (key, value)
                return
            current = current.next

        bucket.insert_back((key, value))
        self._size += 1

        if self._size / self._capacity > 0.75:
            self._resize()

    def get(self, key: str) -> object | None:
        index = self._hash(key)
        bucket = self._buckets[index]

        current = bucket.head
        while current is not None:
            entry = current.data
            if entry[0] == key:
                return entry[1]
            current = current.next

        return None

    def remove(self, key: str) -> bool:
        index = self._hash(key)
        bucket = self._buckets[index]

        current: Node | None = bucket.head
        while current is not None:
            entry = current.data
            if entry[0] == key:
                bucket.remove_node(current)
                self._size -= 1
                return True
            current = current.next

        return False

    def contains(self, key: str) -> bool:
        return self.get(key) is not None

    def keys(self) -> list[str]:
        result: list[str] = []
        bucket_index = 0
        while bucket_index < self._capacity:
            current = self._buckets[bucket_index].head
            while current is not None:
                entry = current.data
                result.append(entry[0])
                current = current.next
            bucket_index += 1
        return result

    def size(self) -> int:
        return self._size

    def _resize(self) -> None:
        old_buckets = self._buckets
        self._capacity *= 2
        self._buckets = [DoublyLinkedList() for _ in range(self._capacity)]
        old_size = self._size
        self._size = 0

        bucket_index = 0
        old_bucket_count = len(old_buckets)
        while bucket_index < old_bucket_count:
            current = old_buckets[bucket_index].head
            while current is not None:
                entry = current.data
                self.put(entry[0], entry[1])
                current = current.next
            bucket_index += 1

        self._size = old_size
